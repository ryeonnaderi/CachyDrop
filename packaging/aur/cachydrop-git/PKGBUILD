
# Maintainer: ryeonnaderi
pkgname=cachydrop-git
pkgver=0.1.0.r20.g137caeb
pkgrel=1
pkgdesc="Local file transfers between Linux computers and phones"
arch=('x86_64')
url="https://github.com/ryeonnaderi/CachyDrop"
license=('MIT')

depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-shadertools'
  'kirigami'
  'qrencode'
  'libsodium'
)

makedepends=(
  'git'
  'cmake'
  'gcc'
  'pkgconf'
  'ninja'
)

source=("CachyDrop::git+https://github.com/ryeonnaderi/CachyDrop.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/CachyDrop" || return 1
  local count hash
  count=$(git rev-list --count HEAD) || return 1
  hash=$(git rev-parse --short HEAD) || return 1
  printf '0.1.0.r%s.g%s\n' "$count" "$hash"
}

build() {
  cmake -S "$srcdir/CachyDrop" -B "$srcdir/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -G Ninja
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  install -Dm644 "$srcdir/CachyDrop/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
